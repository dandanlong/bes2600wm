index be199bc54..f897ff76f 100644
--- a/scripts/link/armca_psram.lds.S
+++ b/scripts/link/armca_psram.lds.S
@@ -534,6 +534,44 @@ SECTIONS
 		__psram_bss_end__ = .;
 	} > PSRAM
 #endif
+	/* Dedicated 1 MiB effects RAM in the separate 3 MiB PSRAM bank. */
+	.fx_psram_pool (NOLOAD) :
+	{
+		. = ALIGN(64);
+		__fx_pool_start = .;
+		*libapps.a:*xmos_fx_chain*.o(.bss .bss.* COMMON)
+		*libapps.a:*global*.o(.bss .bss.* COMMON)
+		*libapps.a:*VoxAC30*.o(.bss .bss.* COMMON)
+		*libapps.a:*Marshall800*.o(.bss .bss.* COMMON)
+		*libapps.a:*MesaBoogie*.o(.bss .bss.* COMMON)
+		*libapps.a:*FenderTwinReverb*.o(.bss .bss.* COMMON)
+		*libapps.a:*DiezelCH4*.o(.bss .bss.* COMMON)
+		*libapps.a:*Vox212*.o(.bss .bss.* COMMON)
+		*libapps.a:*Mesa412*.o(.bss .bss.* COMMON)
+		*libapps.a:*Marshall212*.o(.bss .bss.* COMMON)
+		*libapps.a:*Marshall412*.o(.bss .bss.* COMMON)
+		*libapps.a:*FenderTwinReverb212*.o(.bss .bss.* COMMON)
+		*libapps.a:*Diezel412*.o(.bss .bss.* COMMON)
+		*libapps.a:*Ts808*.o(.bss .bss.* COMMON)
+		*libapps.a:*MxrDisPlus*.o(.bss .bss.* COMMON)
+		*libapps.a:*Vintage_ProcoRat*.o(.bss .bss.* COMMON)
+		*libapps.a:*CompressorA*.o(.bss .bss.* COMMON)
+		*libapps.a:*chorus*.o(.bss .bss.* COMMON)
+		*libapps.a:*pureDelay*.o(.bss .bss.* COMMON)
+		*libapps.a:*EQT1*.o(.bss .bss.* COMMON)
+		*libapps.a:*reverbT1*.o(.bss .bss.* COMMON)
+		*libapps.a:*Tremolo*.o(.bss .bss.* COMMON)
+		*libapps.a:*autoPan*.o(.bss .bss.* COMMON)
+		*libapps.a:*multiBandCompT0*.o(.bss .bss.* COMMON)
+		. = ALIGN(64);
+		__fx_alloc_start = .;
+		. = __fx_pool_start + 0x100000;
+		. = ALIGN(64);
+		__fx_pool_end = .;
+	} > PSRAM
+	ASSERT(__fx_alloc_start <= __fx_pool_end, "XMOS FX state exceeds 1MiB pool")
+	ASSERT(__fx_pool_end <= ORIGIN(PSRAM) + LENGTH(PSRAM), "FX pool overflows PSRAM")
+
 #endif
 	. = __sram_data_end_load__;
 
