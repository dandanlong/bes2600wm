+/****************************************************************************
+ * Private Data (DMA yield semaphore — free CPU while waiting on SD DMA)
+ ****************************************************************************/
+
+static sem_t g_sdmmc_dma_sem;
+static bool g_sdmmc_dma_sem_inited;
+
+static void bes_sdmmc_sem_init(void)
+{
+  if (!g_sdmmc_dma_sem_inited)
+    {
+      nxsem_init(&g_sdmmc_dma_sem, 0, 0);
+      g_sdmmc_dma_sem_inited = true;
+    }
+  else
+    {
+      while (nxsem_trywait(&g_sdmmc_dma_sem) >= 0)
+        {
+        }
+    }
+}
+
+static void bes_sdmmc_sem_reset(void)
+{
+  if (!g_sdmmc_dma_sem_inited)
+    {
+      return;
+    }
+  while (nxsem_trywait(&g_sdmmc_dma_sem) >= 0)
+    {
+    }
+}
+
+static void bes_sdmmc_sem_post(enum HAL_SDMMC_DEVICE_RW_T dir)
+{
+  (void)dir;
+  if (g_sdmmc_dma_sem_inited)
+    {
+      nxsem_post(&g_sdmmc_dma_sem);
+    }
+}
+
+static enum HAL_SDMMC_ERR_T bes_sdmmc_sem_wait(void)
+{
+  struct timespec abs;
+  int ret;
+
+  if (!g_sdmmc_dma_sem_inited)
+    {
+      return HAL_SDMMC_ERR_SEM;
+    }
+
+  if (clock_gettime(CLOCK_REALTIME, &abs) != 0)
+    {
+      /* Fallback: untimed wait (HAL still has outer DMA timeout). */
+      if (nxsem_wait(&g_sdmmc_dma_sem) == 0)
+        {
+          return HAL_SDMMC_ERR_NONE;
+        }
+      return HAL_SDMMC_ERR_SEM;
+    }
+
+  abs.tv_sec += BES_SDMMC_DMA_WAIT_SEC;
+  ret = nxsem_timedwait_uninterruptible(&g_sdmmc_dma_sem, &abs);
+  if (ret == 0)
+    {
+      return HAL_SDMMC_ERR_NONE;
+    }
+  if (ret == -ETIMEDOUT)
+    {
+      return HAL_SDMMC_DMA_XFER_TIMEOUT;
+    }
+  return HAL_SDMMC_ERR_SEM;
+}
+
+static struct HAL_SDMMC_CB_T g_bes_sdmmc_cb =
+{
+  .hal_sdmmc_signal_voltage_switch = NULL,
+  .hal_sdmmc_host_error = NULL,
+  .hal_sdmmc_txrx_done = NULL, /* HAL true-nonblock path is incomplete */
+  .hal_sdmmc_sem_init = bes_sdmmc_sem_init,
+  .hal_sdmmc_sem_reset = bes_sdmmc_sem_reset,
+  .hal_sdmmc_sem_post = bes_sdmmc_sem_post,
+  .hal_sdmmc_sem_wait = bes_sdmmc_sem_wait,
+};
+
+static void bes_sdmmc_cfg_defaults(FAR struct HAL_SDMMC_CONFIG_T *cfg)
+{
+  memset(cfg, 0, sizeof(*cfg));
+  cfg->yield = true; /* DMA wait via sem_wait — frees CPU1 for lower-prio work */
+  cfg->ddr_mode = false;
+  cfg->volt_switch = false;
+  cfg->device_type = HAL_SDMMC_DEVICE_TYPE_SD;
+  cfg->bus_speed = CONFIG_BES_SDMMC_SPEED;
+#if defined(CONFIG_SDIO_WIDTH_D1_ONLY)
+  cfg->bus_width = HAL_SDMMC_BUS_WIDTH_1;
+#else
+  cfg->bus_width = HAL_SDMMC_BUS_WIDTH_4;
 #endif
+}
+
+static int bes_sdmmc_open_host(void)
+{
